<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl dark:text-gray-100">Confirm your email address</h1>

  <p class="mt-5 text-gray-700 dark:text-gray-300">
    Confirm <strong><%= @address %></strong> as the email address for your Clinch account.
  </p>

  <%= form_with url: email_confirmation_path(params[:token]), method: :patch, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.submit "Confirm #{@address}", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
